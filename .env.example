# Turso DB（ローカル開発ではデフォルトで file:local.db が使われるため設定不要）
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Auth
BETTER_AUTH_SECRET=

# BETTER_AUTH_URL は「このオリジンに固定する」という宣言。秘密情報ではないので
# fnox で管理しない（秘密でない値を secret store に置くと、実際の起動ポートより
# 先に勝って気づきにくい事故を起こす）。
#
# - ローカルでは不要。未設定なら実際の起動ポートから導出される
#   （src/lib/base-url.ts）ので、既定の 3000 なら同じ値になる
# - production では Vercel の環境変数として設定する
# - `pnpm dev:preview`（OAuth エミュレータ）では参照されない。
#   あちらは PORTLESS_URL → PORT の順で実際の起動先から導出する
# BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
# local / production: 本物の値を入れる
# OAuth エミュレータ利用時（pnpm dev:preview / Vercel preview）: ダミー値
# (client=emulate-client / secret=emulate-secret) で動く。
# あわせて NEXT_PUBLIC_VERCEL_ENV=preview で @emulators/google が有効化される
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel AI Gateway
# ローカルは API キー必須。Vercel 上は OIDC で自動認証されるため不要
AI_GATEWAY_API_KEY=
# <provider>/<model> 形式で差し替え可能（既定: google/gemini-2.5-flash）
# claude 系は Vercel 有料クレジットが必要
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-4-6
